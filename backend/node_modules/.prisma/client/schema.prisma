// ==========================================================
// Havalimanı Uçuş Ekibi & Vardiya Planlama Sistemi
// Prisma Schema
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PRODUCTION: PostgreSQL (Supabase, Render, Railway vb.)
  // Yerelde SQLite ile test etmek isterseniz "sqlite" yapıp
  // DATABASE_URL'i "file:./dev.db" olarak ayarlayın.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------
// NOT: SQLite enum tipini desteklemediği için roller/durumlar
// String olarak tutulur. Geçerli değerler kod içinde (services,
// validators) TypeScript union tipleriyle zaten kısıtlanmıştır:
//   CrewRole:    "PILOT" | "CO_PILOT" | "CABIN_CHIEF" | "FLIGHT_ATTENDANT"
//   CrewStatus:  "ACTIVE" | "INACTIVE" | "ON_LEAVE"
//   FlightStatus (sıralı akış):
//     "PLANNED" -> "READY" -> "TAXI" -> "CLEARED_TAKEOFF" -> "AIRBORNE"
//     -> "CLEARED_LANDING" -> "COMPLETED"
//     Her aşamadan "CANCELLED" durumuna geçilebilir.
// PostgreSQL'e geçerken bunlar tekrar `enum` olarak tanımlanabilir.
// ----------------------------------------------------------

// ----------------------------------------------------------
// PERSONEL (CREW)
// ----------------------------------------------------------
model Crew {
  id               String @id @default(cuid())
  name             String
  email            String @unique
  role             String // bkz. CrewRole union tipi
  status           String @default("ACTIVE") // bkz. CrewStatus union tipi
  totalFlightHours Float  @default(0) // toplam uçuş saati (kümülatif)
  weeklyLimitHours Float  @default(40) // haftalık mesai sınırı

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

// ----------------------------------------------------------
// UÇUŞLAR (FLIGHTS)
// ----------------------------------------------------------
model Flight {
  id            String   @id @default(cuid())
  flightCode    String   @unique // Örn: TK1920
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  status        String   @default("PLANNED") // bkz. FlightStatus union tipi

  assignments Assignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departureTime])
  @@index([status])
}

// ----------------------------------------------------------
// ATAMALAR (ASSIGNMENTS)
// ----------------------------------------------------------
model Assignment {
  id         String   @id @default(cuid())
  flightId   String
  crewId     String
  assignedAt DateTime @default(now())

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)
  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)

  @@unique([flightId, crewId]) // aynı personel aynı uçuşa 2 kez atanamaz
  @@index([flightId])
  @@index([crewId])
}

// ----------------------------------------------------------
// İŞLEM GEÇMİŞİ (AUDIT LOG)
// Personel/uçuş/atama üzerinde yapılan her önemli işlem burada
// kayıt altına alınır. Dashboard'da "Son İşlemler" olarak gösterilir.
// ----------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  action     String // Örn: "CREW_CREATED", "FLIGHT_STATUS_CHANGED", "ASSIGNMENT_CREATED"
  message    String // Kullanıcıya gösterilecek okunabilir mesaj (Türkçe)
  entityType String // "CREW" | "FLIGHT" | "ASSIGNMENT"
  entityId   String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}
