# SQLite - dosya tabanlı, kurulum gerektirmez.
DATABASE_URL="file:./dev.db"

# PostgreSQL'e geçmek isterseniz (Docker/kurulu Postgres varsa) şunu kullanın:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crewdb?schema=public"
# ve prisma/schema.prisma içindeki provider'ı "postgresql" yapın.

# Sunucu portu
PORT=4000

# Haftalık mesai limiti (varsayılan, saat)
WEEKLY_HOUR_LIMIT=40

# Uçuşun "Hazır" sayılması için gereken minimum roller
MIN_PILOT=1
MIN_CO_PILOT=1
MIN_CABIN_CREW=2
